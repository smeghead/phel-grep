(ns grep\main
  (:require phel\str)
  (:require grep\modules\input)
  (:require grep\modules\matcher))

(defn grep [regexp in-stream out-stream]
  (doseq [line :in (input/stream-line-seq in-stream)]
    (if (matcher/match line regexp)
      (php/fwrite out-stream line)))
  0)

(defn getopt [global]
  (let [arguments (php->phel (php/aget global "argv"))
        self "main.phel"
        index (find-index |(str/contains? $ self) arguments)
]
    (println arguments)
    (println self)
    (println index)
    #(slice arguments index)
))
    
(println (getopt php/$_SERVER))
