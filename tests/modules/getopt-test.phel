(ns tests\grep\modules\getopt-test
  (:require grep\modules\getopt)
  (:require phel\test :refer [deftest is]))

(deftest phel-index-as-script
  (let [result (getopt/phel-index ["vendor/bin/phel" "run" "src/main.phel"] "main.phel" "grep\main")]
    (is (= result 2))))

(deftest phel-index-as-namespace
  (let [result (getopt/phel-index ["vendor/bin/phel" "run" "grep\main"] "main.phel" "grep\main")]
    (is (= result 2))))

(deftest phel-index-as-php-compiled
  (let [result (getopt/phel-index ["php" "out/main.php"] "main.phel" "grep\main")]
    (is (= result 1))))

(deftest run-as-script-no-argv
  (let [result (getopt/getopt "vendor/bin/phel run src/main.phel" "/app/src/main.phel" "grep\main")]
    (is (= (result :args) []))
    (is (= (result :options) {}))))

(deftest run-as-namespace-no-argv
  (let [result (getopt/getopt "vendor/bin/phel run grep\main" "/app/src/main.phel" "grep\main")]
    (is (= (result :args) []))
    (is (= (result :options) {}))))

(deftest run-as-php-no-argv
  (let [result (getopt/getopt "out/main.php" "/app/src/main.phel" "grep\main")]
    (is (= (result :args) []))
    (is (= (result :options) {}))))

(deftest run-as-script-2-arguments
  (let [result (getopt/getopt "vendor/bin/phel run src/main.phel one two" "/app/src/main.phel" "grep\main")]
    (is (= (result :args) ["one" "two"]))
    (is (= (result :options) {}))))

(deftest run-as-namespace-2-arguments
  (let [result (getopt/getopt "vendor/bin/phel run grep\main one two" "/app/src/main.phel" "grep\main")]
    (is (= (result :args) ["one" "two"]))
    (is (= (result :options) {}))))
