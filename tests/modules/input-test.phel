(ns grep\modules\input-test
  (:require grep\modules\input)
  (:require phel\test :refer [deftest is]))

(deftest convert-stream-to-lazy-sequence
  (let [in-stream (php/fopen "./tests/small.txt" "r")
        out-stream (php/fopen "php://memory" "w")
        results (doall (input/stream-line-seq in-stream))]
    (is (= (count results)) 6)
    (is (= (results 0) "Built on PHP Ecosystem\r\n"))))
